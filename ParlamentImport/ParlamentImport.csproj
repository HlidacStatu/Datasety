<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Standalone importer: talks to Hlidac statu only through the public REST API (NuGet HlidacStatu.Api.V2.Dataset
      for the dataset, HlidacStatu.Api.V2 for persons). See DOC.md.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>HlidacStatu.ParlamentImport</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="ParlamentImport.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="HlidacStatu.Api.V2" Version="2.4.1.2" />
        <PackageReference Include="HlidacStatu.Api.V2.Dataset" Version="2.4.1.1" />
        <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.14" />
        <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.14" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="Newtonsoft.Json.Schema" Version="3.0.16" />
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="logger.serilog.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
